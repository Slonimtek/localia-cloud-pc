[Unit]
Description=Localia portal
After=network-online.target localia-net.service
[Service]
User=localia
Group=localia
WorkingDirectory=/opt/localia/portal
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=2
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
Environment=NODE_ENV=production
[Install]
WantedBy=multi-user.target
